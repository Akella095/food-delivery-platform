# === Shared secrets ===
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === user-service database ===
USER_DB_USER=postgres
USER_DB_PASSWORD=postgres
USER_DB_NAME=user_db
USER_DB_HOST=user-db
USER_DB_PORT=5432
USER_DATABASE_URL=postgresql+asyncpg://${USER_DB_USER}:${USER_DB_PASSWORD}@${USER_DB_HOST}:${USER_DB_PORT}/${USER_DB_NAME}

# === order-service database ===
ORDER_DB_USER=postgres
ORDER_DB_PASSWORD=postgres
ORDER_DB_NAME=order_db
ORDER_DB_HOST=order-db
ORDER_DB_PORT=5432
ORDER_DATABASE_URL=postgresql+asyncpg://${ORDER_DB_USER}:${ORDER_DB_PASSWORD}@${ORDER_DB_HOST}:${ORDER_DB_PORT}/${ORDER_DB_NAME}

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === RabbitMQ ===
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# === Misc ===
CACHE_TTL_SECONDS=60
